{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["storybook"],
      "port": 6006
    },
    {
      "name": "cart-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".cart-preview", "-l", "4444", "--no-clipboard"],
      "port": 4444
    }
  ]
}
